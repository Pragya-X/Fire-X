[TEMPLATE]
# ---------------------------------------------------------------------------
# FIRE-X backend configuration
# Copy to .env for local development. Demo providers require DEMO_MODE=true.
# With DEMO_MODE=false, missing providers remain unavailable.
# ---------------------------------------------------------------------------

# Database - SQLite by default (zero config). Use Postgres/PostGIS for prod:
#   DATABASE_URL=postgresql://firex:firex@localhost:5432/firex
DATABASE_URL=sqlite:///./firex.db

# Auth
JWT_SECRET=firex-dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# Google OAuth (optional: server-side endpoints activate only when credentials are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Where the frontend runs (reset links / OAuth callback redirect here)
FRONTEND_URL=http://localhost:3000

# Email (SMTP) - Gmail app password works: https://myaccount.google.com/apppasswords
# Used for password reset, new-account welcome, and CRITICAL alert emails.
# When unset, emails are written to data/outbox/*.eml (console fallback) so the
# demo flow still works without credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_FROM_NAME=FIRE-X
# Comma-separated recipients for operational alert emails; defaults to the acting user's email
MAIL_ALERT_RECIPIENTS=

# NASA FIRMS (live data when set; otherwise deterministic demo detections)
FIRMS_API_KEY=
FIRMS_MAP_KEY=
FIRMS_API_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv

# Planet imagery catalog metadata only; pixel validation is not implemented.
SATELLITE_API_KEY=

# AI Copilot - LLM mode when set; deterministic rule-based mode otherwise
OPENAI_API_KEY=

# OpenStreetMap Overpass endpoint (live OSM ingestion when reachable)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# CORS
CORS_ORIGINS=*

# Demo / tuning
DEMO_MODE=true
AUTO_ALERT_RISK_THRESHOLD=80
# Explicit classifier provenance: rules | demo | trained
ML_MODE=rules
ML_FALLBACK_MODE=rules

# Reviewed event classifier is separate from the legacy 14-feature model.
# Leave blank until real-data gates pass and an operator writes a hash-bound approval.
EVENT_MODEL_PATH=

# Production requires ENV=production, DEBUG=false, DEMO_MODE=false, PostgreSQL,
# an explicit HTTPS CORS_ORIGINS and a unique 32+ character JWT_SECRET.
# Google OAuth remains disabled in production pending a dedicated security review.
# When DEMO_MODE=false, legacy live ingestion uses this explicit real bundle or empty context.
# Restart the backend after changing the bundle or its layer files.
REFERENCE_BUNDLE_PATH=
